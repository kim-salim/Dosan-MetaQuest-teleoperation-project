# ROS2 / colcon build outputs
build/
install/
log/

# ROS runtime / local state
.ros/
.colcon/

# Python cache and test artifacts
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# ROS bag / recordings
*.bag
*.db3
*.mcap

# Logs
*.log

# Editor / OS local files
.vscode/
.idea/
.DS_Store

# Local credentials / private connection information
salim_imformation
.env
**/.env
!**/.env.example
*.pem
*.key

# Python-generated package metadata
**/*.egg-info/

# Local patch/editor backups
*.orig
*.rej

# Generated experiment artifacts (curated summaries may be force-added)
/docs/artifacts/
/camera_video*.jpg

# Local LeRobot training mounts and outputs
/docker/lerobot_training/data/
/docker/lerobot_training/outputs*/
/docker/lerobot_training/cache*/
/docker/lerobot_training/user-home*/

# Coverage outputs
.coverage
htmlcov/
