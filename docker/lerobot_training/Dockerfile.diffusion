ARG PYTORCH_IMAGE=pytorch/pytorch:2.11.0-cuda13.0-cudnn9-runtime
FROM ${PYTORCH_IMAGE}

ARG LEROBOT_VERSION=0.6.0
ARG HOST_UID=6010
ARG HOST_GID=6010

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        git \
        git-lfs \
        libgl1 \
        libglib2.0-0 \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv --system-site-packages /opt/lerobot-diffusion-venv

ENV VIRTUAL_ENV=/opt/lerobot-diffusion-venv \
    PATH="/opt/lerobot-diffusion-venv/bin:${PATH}"

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install \
        "click>=8,<8.4,!=8.3.0" \
        "lerobot[training,diffusion]==${LEROBOT_VERSION}" \
    && python -m pip check

RUN python - <<'PY'
import importlib.metadata as metadata
import torch

assert metadata.version("lerobot") == "0.6.0"
assert torch.__version__.startswith("2.11.0"), torch.__version__
print("lerobot", metadata.version("lerobot"))
print("diffusers", metadata.version("diffusers"))
print("torch", torch.__version__)
PY

RUN groupadd --gid "${HOST_GID}" lerobot \
    && useradd --uid "${HOST_UID}" --gid "${HOST_GID}" \
        --no-create-home --home-dir /workspace/user-home \
        --shell /bin/bash lerobot

COPY --chmod=0755 verify_gpu0.sh train_diffusion.sh /opt/lerobot/bin/

WORKDIR /workspace
CMD ["bash"]
