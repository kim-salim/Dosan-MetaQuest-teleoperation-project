# syntax=docker/dockerfile:1.7

# Jetson Thor runs Ubuntu 24.04 and ROS 2 Jazzy natively. Keep the container on
# the same ROS distribution and use Doosan's official Jazzy arm64 DRFL library.
FROM ros:jazzy-ros-base-noble

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DRCF_VER=2
ARG INSTALL_GUI=0
ARG DEBIAN_FRONTEND=noninteractive

ENV ROS_DISTRO=jazzy \
    ROS_DOMAIN_ID=29 \
    ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET \
    RCUTILS_COLORIZED_OUTPUT=1

WORKDIR /ros2_ws

RUN detected_arch="$(dpkg --print-architecture)" \
    && if [[ "${detected_arch}" != "arm64" ]]; then \
         echo "Dockerfile.jetson requires arm64, detected ${detected_arch}."; \
         exit 1; \
       fi

RUN printf 'APT::Install-Recommends "0";\nAPT::Install-Suggests "0";\n' \
      > /etc/apt/apt.conf.d/99no-recommends \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      bash-completion \
      build-essential \
      git \
      iproute2 \
      iputils-ping \
      libpoco-dev \
      libyaml-cpp-dev \
      python3-colcon-common-extensions \
      python3-pip \
      python3-pytest \
      ros-jazzy-ament-copyright \
      ros-jazzy-ament-flake8 \
      ros-jazzy-ament-pep257 \
      python3-rosdep \
      python3-vcstool \
      wget \
    && if [[ "${INSTALL_GUI}" == "1" ]]; then \
         apt-get install -y --no-install-recommends \
           python3-tk \
           ros-${ROS_DISTRO}-rviz2; \
       fi \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true

COPY src ./src

RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && rosdep update --rosdistro "${ROS_DISTRO}" \
    && apt-get update \
    && rosdep install \
      --from-paths \
        src/quest2ros \
        src/ros_tcp_communication \
        src/quest_a0509_teleop \
        src/jrt_gripper_io \
        src/doosan-robot2/dsr_msgs2 \
        src/doosan-robot2/dsr_common2 \
        src/doosan-robot2/dsr_hardware2 \
        src/doosan-robot2/dsr_controller2 \
        src/doosan-robot2/dsr_description2 \
      --ignore-src \
      --rosdistro "${ROS_DISTRO}" \
      -r -y \
      -t buildtool -t build -t build_export -t buildtool_export -t exec \
      --skip-keys "ament_python joint_state_publisher_gui ros_gz rviz2" \
    && rm -rf /var/lib/apt/lists/* \
    && colcon build \
      --merge-install \
      --packages-select \
        quest2ros \
        ros_tcp_endpoint \
        dsr_msgs2 \
        dsr_common2 \
        dsr_hardware2 \
        dsr_controller2 \
        dsr_description2 \
        quest_a0509_teleop \
        jrt_gripper_io \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release \
        -DDRCF_VER="${DRCF_VER}"

RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && source /ros2_ws/install/setup.bash \
    && test "$(dpkg --print-architecture)" = "arm64" \
    && test -f /ros2_ws/src/doosan-robot2/dsr_common2/lib/jazzy/arm64/libDRFL.a \
    && ros2 pkg prefix quest2ros \
    && ros2 pkg prefix ros_tcp_endpoint \
    && ros2 pkg prefix quest_a0509_teleop \
    && ros2 pkg prefix dsr_controller2 \
    && ros2 pkg prefix dsr_description2 \
    && python3 -c \
      "from dsr_msgs2.msg import ServolRtStream; from dsr_msgs2.srv import GetRobotState; from quest2ros.msg import OVR2ROSInputs" \
    && ros2 launch quest_a0509_teleop \
      a0509_full_bringup_with_gripper.launch.py --show-args >/dev/null

RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && source /ros2_ws/install/setup.bash \
    && colcon test \
      --merge-install \
      --packages-select quest2ros ros_tcp_endpoint quest_a0509_teleop jrt_gripper_io \
    && colcon test-result --verbose

COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
