# syntax=docker/dockerfile:1.7

# Jetson Thor runs an arm64 ROS 2 Humble userspace on the Ubuntu 24.04 host.
# The Doosan driver in this workspace currently ships its supported DRFL
# library at dsr_common2/lib/humble/arm64/libDRFL.a.
FROM ros:humble-ros-base-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DRCF_VER=2
ARG DEBIAN_FRONTEND=noninteractive

ENV ROS_DISTRO=humble \
    ROS_DOMAIN_ID=29 \
    ROS_LOCALHOST_ONLY=0 \
    RCUTILS_COLORIZED_OUTPUT=1 \
    QT_X11_NO_MITSHM=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display

WORKDIR /ros2_ws

# Fail early if this Jetson-specific Dockerfile was accidentally built for
# amd64. On an amd64 workstation, pass: --platform linux/arm64
RUN detected_arch="$(dpkg --print-architecture)" \
    && if [[ "${detected_arch}" != "arm64" ]]; then \
         echo "Dockerfile.jetson requires arm64, detected ${detected_arch}."; \
         exit 1; \
       fi

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash-completion \
      build-essential \
      dbus-x11 \
      git \
      iproute2 \
      iputils-ping \
      libgl1-mesa-dri \
      libglx-mesa0 \
      libpoco-dev \
      libyaml-cpp-dev \
      mesa-utils \
      python3-colcon-common-extensions \
      python3-pip \
      python3-rosdep \
      python3-tk \
      python3-vcstool \
      wget \
      xauth \
      ros-${ROS_DISTRO}-control-msgs \
      ros-${ROS_DISTRO}-controller-manager \
      ros-${ROS_DISTRO}-example-interfaces \
      ros-${ROS_DISTRO}-force-torque-sensor-broadcaster \
      ros-${ROS_DISTRO}-forward-command-controller \
      ros-${ROS_DISTRO}-gazebo-msgs \
      ros-${ROS_DISTRO}-gazebo-ros2-control \
      ros-${ROS_DISTRO}-gazebo-ros-pkgs \
      ros-${ROS_DISTRO}-hardware-interface \
      ros-${ROS_DISTRO}-ign-ros2-control \
      ros-${ROS_DISTRO}-joint-state-broadcaster \
      ros-${ROS_DISTRO}-joint-state-publisher-gui \
      ros-${ROS_DISTRO}-joint-trajectory-controller \
      ros-${ROS_DISTRO}-kdl-parser \
      ros-${ROS_DISTRO}-moveit-configs-utils \
      ros-${ROS_DISTRO}-moveit-msgs \
      ros-${ROS_DISTRO}-moveit-ros-move-group \
      ros-${ROS_DISTRO}-position-controllers \
      ros-${ROS_DISTRO}-realtime-tools \
      ros-${ROS_DISTRO}-robot-state-publisher \
      ros-${ROS_DISTRO}-ros-gz \
      ros-${ROS_DISTRO}-ros-gz-sim \
      ros-${ROS_DISTRO}-ros2-control \
      ros-${ROS_DISTRO}-ros2-controllers \
      ros-${ROS_DISTRO}-ros2controlcli \
      ros-${ROS_DISTRO}-rviz2 \
      ros-${ROS_DISTRO}-transmission-interface \
      ros-${ROS_DISTRO}-velocity-controllers \
      ros-${ROS_DISTRO}-xacro \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true

COPY src ./src

RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && rosdep update --rosdistro "${ROS_DISTRO}" \
    && apt-get update \
    && rosdep install \
      --from-paths src \
      --ignore-src \
      --rosdistro "${ROS_DISTRO}" \
      -r -y \
      -t buildtool -t build -t build_export -t buildtool_export -t exec \
      --skip-keys ament_python \
    && rm -rf /var/lib/apt/lists/* \
    && colcon build \
      --merge-install \
      --cmake-args \
        -DCMAKE_BUILD_TYPE=Release \
        -DDRCF_VER="${DRCF_VER}"

# Validate that the integrated Quest packages and the arm64 Doosan driver are
# available without sourcing any external workspace.
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
    && source /ros2_ws/install/setup.bash \
    && test "$(dpkg --print-architecture)" = "arm64" \
    && test -f /ros2_ws/src/doosan-robot2/dsr_common2/lib/humble/arm64/libDRFL.a \
    && ros2 pkg prefix quest2ros \
    && ros2 pkg prefix ros_tcp_endpoint \
    && ros2 pkg prefix quest_a0509_teleop \
    && ros2 pkg prefix dsr_bringup2 \
    && python3 -c \
      "from quest2ros.msg import OVR2ROSInputs; OVR2ROSInputs.__class__.__import_type_support__()"

COPY docker/ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
